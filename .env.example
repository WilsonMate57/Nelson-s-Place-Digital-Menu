# Nelson's Place digital menu — server configuration.
# Copy to `.env` for local use, or set these in Plesk (Node.js → Custom environment variables).
# NEVER commit a real `.env`. Values below are placeholders.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# SQLite database file and uploaded images (both must be on persistent, backed-up storage).
DATABASE_PATH=data/nelsons-place.db
UPLOADS_DIR=uploads
STATIC_DIR=dist/client

# Sub-path when the menu is not at the domain root, e.g. /menu for https://example.co.mz/menu/ (empty = root).
BASE_PATH=

# Public address of the site (including BASE_PATH, e.g. https://example.co.mz/menu), used for dashboard links in WhatsApp messages.
PUBLIC_BASE_URL=https://menu.example.co.mz

# true when running behind Plesk/nginx/Passenger (needed for correct client IPs / rate limiting).
TRUST_PROXY=true

# Session cookies are Secure (HTTPS-only) in production. Set false ONLY for local HTTP testing.
# COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# WhatsApp forwarding: "link" (default, prefilled wa.me link, no credentials) or
# "cloud_api" (official WhatsApp Business Platform; see docs/WHATSAPP.md).
# The hotel's WhatsApp NUMBER is set in the dashboard (Definições), not here.
WHATSAPP_MODE=link
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
# Optional: second approved template for the automatic daily summary to the manager.
WHATSAPP_SUMMARY_TEMPLATE_NAME=

# Optional SMTP account to email the daily summary to the manager (Definições → Resumo diário).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
